{
    "configurations": [
        {
            "name": "Objdump",
            "request": "launch",
            "program": "${workspaceRoot}/build/tools/obj-dump",
            "type": "cppdbg",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceRoot}/build/tools/obj-dump.exe",
            },
            "args": [
                "STYLE001.GRY",
                "NYC.CMP"
            ],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal"
        },
        {
            "name": "Spriteplayer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tools/spriteplayer",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}/build/tools/spriteplayer.exe",
            },
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal"
        },
        {
            "name": "LuaMapTest",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/tests/lua_map_test",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceRoot}/build/tests/lua_map_test.exe",
            },
            "args": [
                "NYC.CMP",
                "${workspaceRoot}/scripts/map_test_blocktype.lua"
            ],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal",
        },
        {
            "name": "Viewer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/programs/viewer",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceRoot}/build/programs/viewer.exe",
            },
            "args": [
                "-c"
            ],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal"
        },
        {
            "name": "LuaViewer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/programs/viewer",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceRoot}/build/programs/viewer.exe",
            },
            "args": [
                "-c",
                "-s",
                "${workspaceRoot}/scripts/parser.lua"
            ],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal"
        },
    ],
    "version": "2.0.0"
}
