{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "vcpkg-asan",
            "inherits": "vcpkg",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "address"
            }
        },
        {
            "name": "vcpkg-msan",
            "inherits": "vcpkg",
            "binaryDir": "${sourceDir}/build-msan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "memory"
            }
        },
        {
            "name": "vcpkg-ubsan",
            "inherits": "vcpkg",
            "binaryDir": "${sourceDir}/build-ubsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "undefined"
            }
        },
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build"
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg-debug",
            "configurePreset": "vcpkg",
            "configuration": "Debug"
        },
        {
            "name": "vcpkg-relwithdebinfo",
            "configurePreset": "vcpkg",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "default-debug",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "default-relwithdebinfo",
            "configurePreset": "default",
            "configuration": "RelWithDebInfo"
        }
    ]
}
